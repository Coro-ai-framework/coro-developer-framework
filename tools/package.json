{
  "name": "a5-agent-host",
  "version": "0.1.0",
  "description": "A5 Labs Agent Host Service",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/src/index.js",
  "bin": {
    "a5": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:cli": "ts-node cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "dotenv": "^17.4.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "js-yaml": "^4.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "simple-git": "^3.27.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.14",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  }
}
