{
  "name": "a5-agent-host",
  "version": "0.1.0",
  "description": "A5 Labs Agent Host Service",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/src/index.js",
  "bin": {
    "a5": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
