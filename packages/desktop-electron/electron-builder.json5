{
  appId: 'ai.coro.desktop',
  productName: 'Coro',
  artifactName: '${productName}-${version}-${arch}.${ext}',
  npmRebuild: false,
  files: [
    'dist/main.js',
    'dist/main.js.map',
    'dist/preload.js',
    'dist/preload.js.map',
    'package.json',
  ],
  extraResources: [
    {
      from: 'dist/resources/coro',
      to: 'coro',
    },
  ],
  directories: {
    output: 'release',
  },
  publish: [
    {
      provider: 'github',
      owner: 'Coro-ai-framework',
      repo: 'coro-release',
      releaseType: 'release',
      publishAutoUpdate: true,
    },
  ],
  mac: {
    category: 'public.app-category.developer-tools',
    icon: 'dist/icon.icns',
    target: [
      {
        target: 'dmg',
        arch: ['arm64'],
      },
      {
        target: 'zip',
        arch: ['arm64'],
      },
    ],
  },
  win: {
    icon: 'dist/icon.ico',
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
  },
  nsis: {
    oneClick: true,
    perMachine: false,
    allowToChangeInstallationDirectory: false,
  },
  linux: {
    icon: 'dist/icon.png',
    category: 'Development',
    maintainer: 'Coro',
    // AppImages mount read-only; Chromium's setuid sandbox cannot run on the FUSE path.
    executableArgs: ['--no-sandbox'],
    target: [
      {
        target: 'appImage',
        arch: ['x64'],
      },
    ],
    desktop: {
      entry: {
        Name: 'Coro',
        Comment: 'Coro desktop — AI-assisted software delivery',
        Categories: 'Development;',
      },
    },
  },
}