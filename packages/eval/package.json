{
  "name": "@coro-ai/eval",
  "version": "0.1.0",
  "description": "Black-box evaluation harness for Coro. Dispatches jobs against fixed sandbox tasks over the runner's HTTP API, grades the result, and stores every run as plain files.",
  "license": "BUSL-1.1",
  "private": true,
  "type": "commonjs",
  "bin": {
    "coro-eval": "./bin/coro-eval.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node bin/coro-eval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@coro-ai/cloud-protocol": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.14",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  }
}
