--- a/src/errors.ts
+++ b/src/errors.ts
@@ -4,3 +4,32 @@ export class InventoryError extends Error {
     this.name = 'InventoryError'
   }
 }
+
+export interface Shortage {
+  sku: string
+  requested: number
+  available: number
+}
+
+/** A reservation asked for more than is available. Nothing was held. */
+export class InsufficientStockError extends InventoryError {
+  constructor(readonly shortages: Shortage[]) {
+    super(
+      `insufficient stock: ${shortages
+        .map(s => `${s.sku} (requested ${s.requested}, available ${s.available})`)
+        .join(', ')}`,
+    )
+    this.name = 'InsufficientStockError'
+  }
+}
+
+/** The CSV given to `Inventory.fromCsv` is not valid. `line` is 1-based; the header is line 1. */
+export class CsvError extends InventoryError {
+  constructor(
+    message: string,
+    readonly line: number,
+  ) {
+    super(`line ${line}: ${message}`)
+    this.name = 'CsvError'
+  }
+}
