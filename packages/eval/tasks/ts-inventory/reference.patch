+
+  // ── Reservations ───────────────────────────────────────────────────────────
+
+  /** Hold stock for an order. All lines are held, or none are. */
+  reserve(orderId: string, lines: readonly ReservationLine[]): void {
+    if (lines.length === 0) throw new InventoryError('an order needs at least one line')
+    for (const line of lines) assertQuantity(line.quantity)
+    if (this.reservations.has(orderId)) throw new InventoryError(`order ${orderId} already has a reservation`)
+
+    const wanted = new Map<string, number>()
+    for (const { sku, quantity } of lines) wanted.set(sku, (wanted.get(sku) ?? 0) + quantity)
+
+    const shortages: Shortage[] = []
+    for (const [sku, requested] of wanted) {
+      const available = this.available(sku)
+      if (requested > available) shortages.push({ sku, requested, available })
+    }
+    if (shortages.length > 0) throw new InsufficientStockError(shortages)
+
+    const before: Array<[string, number]> = [...wanted.keys()].map(sku => [sku, this.available(sku)])
+    this.reservations.set(orderId, wanted)
+    for (const [sku, quantity] of wanted) this.adjustReserved(sku, quantity)
+    this.notifyLowStock(before)
+  }
+
+  /** Give an order's held units back. */
+  release(orderId: string): void {
+    for (const [sku, quantity] of this.takeReservation(orderId)) this.adjustReserved(sku, -quantity)
+  }
+
+  /** Turn an order's held units into a permanent removal from stock. */
+  commit(orderId: string): void {
+    for (const [sku, quantity] of this.takeReservation(orderId)) {
+      this.adjustReserved(sku, -quantity)
+      this.stockBySku.set(sku, this.stock(sku) - quantity)
+    }
+  }
+
+  private takeReservation(orderId: string): Map<string, number> {
+    const held = this.reservations.get(orderId)
+    if (!held) throw new InventoryError(`order ${orderId} has no active reservation`)
+    this.reservations.delete(orderId)
+    return held
+  }
+
+  private adjustReserved(sku: string, delta: number): void {
+    const next = (this.reservedBySku.get(sku) ?? 0) + delta
+    if (next === 0) this.reservedBySku.delete(sku)
+    else this.reservedBySku.set(sku, next)
+  }
+
+  // ── Reorder alerts ─────────────────────────────────────────────────────────
+
+  /** Alert when `sku`'s availability falls to `point` or below. */
+  setReorderPoint(sku: string, point: number): void {
+    if (!Number.isInteger(point) || point < 0) {
+      throw new InventoryError(`reorder point must be a non-negative whole number, got ${point}`)
+    }
+    if (!this.stockBySku.has(sku)) throw new InventoryError(`unknown SKU ${sku}`)
+    this.reorderPoints.set(sku, point)
+  }
+
+  /** Be told when a SKU's availability drops to its reorder point. Returns an unsubscribe function. */
+  onLowStock(handler: LowStockHandler): () => void {
+    const entry = { handler }
+    this.lowStockHandlers.push(entry)
+    return () => {
+      const index = this.lowStockHandlers.indexOf(entry)
+      if (index >= 0) this.lowStockHandlers.splice(index, 1)
+    }
+  }
+
+  /** `before` is each affected SKU's availability before the change, in the order to report them. */
+  private notifyLowStock(before: ReadonlyArray<readonly [string, number]>): void {
+    const events: LowStockEvent[] = []
+    for (const [sku, availableBefore] of before) {
+      const reorderPoint = this.reorderPoints.get(sku)
+      const available = this.available(sku)
+      if (reorderPoint !== undefined && availableBefore > reorderPoint && available <= reorderPoint) {
+        events.push({ sku, available, reorderPoint })
+      }
+    }
+    for (const event of events) {
+      for (const { handler } of [...this.lowStockHandlers]) {
+        try {
+          handler({ ...event })
+        } catch {
+          // One handler's failure is not the others' problem, and the stock change stands.
+        }
+      }
+    }
+  }
+
+  // ── CSV ────────────────────────────────────────────────────────────────────
+
+  /** One row per SKU: `sku,quantity,reorderPoint`. */
+  exportCsv(): string {
+    const rows = [CSV_HEADER]
+    for (const sku of this.skus()) {
+      if (/[\r\n]/.test(sku)) throw new InventoryError(`SKU ${JSON.stringify(sku)} contains a line break`)
+      const point = this.reorderPoints.get(sku)
+      rows.push([formatField(sku), String(this.stock(sku)), point === undefined ? '' : String(point)].join(','))
+    }
+    return `${rows.join('\n')}\n`
+  }
+
+  /** Build an inventory from `exportCsv` output. */
+  static fromCsv(text: string): Inventory {
+    const lines = text.split(/\r?\n/)
+    if (lines[lines.length - 1] === '') lines.pop()
+    if (lines[0] !== CSV_HEADER) throw new CsvError(`the header must be exactly "${CSV_HEADER}"`, 1)
+
+    const inventory = new Inventory()
+    for (let index = 1; index < lines.length; index++) {
+      const line = index + 1
+      let fields: string[]
+      try {
+        fields = splitLine(lines[index]!)
+      } catch (error) {
+        throw new CsvError(error instanceof Error ? error.message : String(error), line)
+      }
+      if (fields.length !== 3) throw new CsvError(`expected 3 fields, found ${fields.length}`, line)
+
+      const [sku, quantityText, pointText] = fields as [string, string, string]
+      if (sku === '') throw new CsvError('the SKU is empty', line)
+      if (inventory.stockBySku.has(sku)) throw new CsvError(`SKU ${sku} appears more than once`, line)
+      const quantity = parseCount(quantityText)
+      if (quantity === undefined) throw new CsvError(`quantity "${quantityText}" is not a whole number`, line)
+      const point = pointText === '' ? undefined : parseCount(pointText)
+      if (pointText !== '' && point === undefined) {
+        throw new CsvError(`reorder point "${pointText}" is not a whole number`, line)
+      }
+
+      inventory.stockBySku.set(sku, quantity)
+      if (point !== undefined) inventory.reorderPoints.set(sku, point)
+    }
+    return inventory
+  }
 }
