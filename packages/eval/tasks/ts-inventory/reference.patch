+export const CSV_HEADER = 'sku,quantity,reorderPoint'
+
+/** Wrap a field in double quotes, doubling any inside, when it contains a comma or a quote. */
+export function formatField(value: string): string {
+  return /[",]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value
+}
+
+/**
+ * Split one line into fields. A quoted field starts with `"`, writes a
+ * literal quote as `""`, and must be followed by a comma or the end of the
+ * line. A quote anywhere else is an error; the message says which.
+ */
+export function splitLine(line: string): string[] {
+  const fields: string[] = []
+  let i = 0
+  for (;;) {
+    if (line[i] === '"') {
+      let value = ''
+      i += 1
+      for (;;) {
+        if (i >= line.length) throw new Error('quoted field is never closed')
+        const ch = line[i]!
+        if (ch === '"') {
+          if (line[i + 1] === '"') {
+            value += '"'
+            i += 2
+            continue
+          }
+          i += 1
+          break
+        }
+        value += ch
+        i += 1
+      }
+      if (i < line.length && line[i] !== ',') throw new Error('unexpected text after a closing quote')
+      fields.push(value)
+    } else {
+      let end = line.indexOf(',', i)
+      if (end === -1) end = line.length
+      const value = line.slice(i, end)
+      if (value.includes('"')) throw new Error('a quote in the middle of an unquoted field')
+      fields.push(value)
+      i = end
+    }
+    if (i >= line.length) return fields
+    i += 1 // the comma
+    if (i >= line.length) {
+      fields.push('') // a trailing comma leaves an empty last field
+      return fields
+    }
+  }
+}
+
+const DIGITS = /^\d+$/
+
+/** Parse plain digits into a safe whole number, or return undefined. */
+export function parseCount(text: string): number | undefined {
+  if (!DIGITS.test(text)) return undefined
+  const value = Number(text)
+  return Number.isSafeInteger(value) ? value : undefined
+}
