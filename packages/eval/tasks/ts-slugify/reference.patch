index 51404d9..0d4e0f1 100644
--- a/src/strings.ts
+++ b/src/strings.ts
@@ -14,3 +14,31 @@ export function truncate(text: string, max: number): string {
   if (max === 1) return '…'
   return `${text.slice(0, max - 1)}…`
 }
+
+export interface SlugifyOptions {
+  /** Placed between words. Defaults to `-`. */
+  separator?: string
+  /** The longest the result may be. */
+  maxLength?: number
+}
+
+/**
+ * Turn text into a URL-safe slug: lower-case ASCII letters and digits, with
+ * every other run of characters replaced by a single separator.
+ */
+export function slugify(input: string, options: SlugifyOptions = {}): string {
+  const separator = options.separator ?? '-'
+  const words = input
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter(word => word.length > 0)
+
+  let slug = words.join(separator)
+  if (options.maxLength !== undefined) {
+    slug = slug.slice(0, Math.max(0, options.maxLength))
+    while (separator.length > 0 && slug.endsWith(separator)) slug = slug.slice(0, -separator.length)
+  }
+  return slug
+}
