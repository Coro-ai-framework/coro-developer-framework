+
+describe('slugify', () => {
+  it('lower-cases and joins words with a dash', () => {
+    expect(slugify('Hello World')).toBe('hello-world')
+  })
+
+  it('removes accents', () => {
+    expect(slugify('Crème Brûlée')).toBe('creme-brulee')
+  })
+
+  it('collapses punctuation and whitespace and trims the ends', () => {
+    expect(slugify('  Hello,   World!!  ')).toBe('hello-world')
+  })
+
+  it('supports a custom separator', () => {
+    expect(slugify('Hello World', { separator: '_' })).toBe('hello_world')
+  })
+
+  it('cuts to maxLength without leaving a trailing separator', () => {
+    expect(slugify('hello world', { maxLength: 6 })).toBe('hello')
+    expect(slugify('hello wonderful world', { maxLength: 9 })).toBe('hello-won')
+  })
+
+  it('returns an empty string when nothing is left', () => {
+    expect(slugify('!!!')).toBe('')
+  })
