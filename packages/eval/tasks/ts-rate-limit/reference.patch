+++ b/src/rate-limit.ts
@@ -0,0 +1,75 @@
+import { header } from './http'
+import type { Request } from './types'
+
+export interface RateLimitOptions {
+  /** Requests a client may make per window. */
+  limit: number
+  /** Length of a window, in milliseconds. */
+  windowMs: number
+}
+
+export interface RateLimitDecision {
+  allowed: boolean
+  limit: number
+  /** Requests left in the window after this one, never below 0. */
+  remaining: number
+  /** Whole seconds until the window ends, rounded up and at least 1. Only meaningful when rejected. */
+  retryAfterSeconds: number
+}
+
+export interface RateLimiter {
+  /** Count a request from `key` and say whether it may go ahead. */
+  check(key: string): RateLimitDecision
+}
+
+interface Window {
+  start: number
+  count: number
+}
+
+/** Past this many tracked clients, expired windows are swept so memory cannot grow without bound. */
+const SWEEP_THRESHOLD = 10_000
+
+export function createRateLimiter(options: RateLimitOptions & { now: () => number }): RateLimiter {
+  const { limit, windowMs, now } = options
+  if (!Number.isInteger(limit) || limit < 1) throw new RangeError(`rateLimit.limit must be a positive whole number, got ${limit}`)
+  if (!Number.isFinite(windowMs) || windowMs <= 0) throw new RangeError(`rateLimit.windowMs must be positive, got ${windowMs}`)
+
+  const windows = new Map<string, Window>()
+
+  function sweep(time: number): void {
+    for (const [key, window] of windows) {
+      if (time - window.start >= windowMs) windows.delete(key)
+    }
+  }
+
+  return {
+    check(key) {
+      const time = now()
+      if (windows.size > SWEEP_THRESHOLD) sweep(time)
+
+      let window = windows.get(key)
+      if (!window || time - window.start >= windowMs) {
+        window = { start: time, count: 0 }
+        windows.set(key, window)
+      }
+
+      if (window.count >= limit) {
+        const msLeft = window.start + windowMs - time
+        return { allowed: false, limit, remaining: 0, retryAfterSeconds: Math.max(1, Math.ceil(msLeft / 1000)) }
+      }
+
+      window.count += 1
+      return { allowed: true, limit, remaining: limit - window.count, retryAfterSeconds: 0 }
+    },
+  }
+}
+
+/** Who a request belongs to: its API key, else the first forwarded address, else one shared bucket. */
+export function clientKey(request: Request): string {
+  const apiKey = header(request.headers, 'x-api-key')?.trim()
+  if (apiKey) return `key:${apiKey}`
+  const forwarded = header(request.headers, 'x-forwarded-for')?.split(',')[0]?.trim()
+  if (forwarded) return `ip:${forwarded}`
+  return 'anonymous'
+}
diff --git a/tests/rate-limit.test.ts b/tests/rate-limit.test.ts
new file mode 100644
index 0000000..0defaa9
--- /dev/null
+++ b/tests/rate-limit.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it } from 'vitest'
+import { createApp } from '../src/index'
+import type { App } from '../src/index'
+
+function setup(limit: number, windowMs: number): { app: App; clock: { t: number } } {
+  const clock = { t: 1_000 }
+  return { app: createApp({ now: () => clock.t, rateLimit: { limit, windowMs } }), clock }
+}
+
+const get = (app: App, path = '/items', headers?: Record<string, string>) => app.handle({ method: 'GET', path, headers })
+
+describe('rate limiting', () => {
+  it('is off unless configured', () => {
+    const app = createApp()
+    for (let i = 0; i < 20; i++) expect(get(app).status).toBe(200)
+    expect(get(app).headers['x-ratelimit-limit']).toBeUndefined()
+  })
+
+  it('answers 429 once the limit is used up and reports what is left', () => {
+    const { app } = setup(2, 10_000)
+    expect(get(app).headers['x-ratelimit-remaining']).toBe('1')
+    expect(get(app).headers['x-ratelimit-remaining']).toBe('0')
+    const limited = get(app)
+    expect(limited.status).toBe(429)
+    expect(limited.body).toEqual({ error: 'rate_limited' })
+    expect(limited.headers['x-ratelimit-limit']).toBe('2')
+  })
+
+  it('tells the client when to retry, rounded up to whole seconds', () => {
+    const { app, clock } = setup(1, 10_000)
+    get(app)
+    clock.t = 3_500
+    expect(get(app).headers['retry-after']).toBe('8')
+    clock.t = 10_999
+    expect(get(app).headers['retry-after']).toBe('1')
+  })
+
+  it('starts a new window once windowMs has elapsed', () => {
+    const { app, clock } = setup(1, 10_000)
+    get(app)
+    clock.t = 11_000
+    expect(get(app).status).toBe(200)
+  })
+
+  it('keeps clients apart: api key first, then the first forwarded address, then anonymous', () => {
+    const { app } = setup(1, 60_000)
+    expect(get(app, '/items', { 'X-API-Key': 'a', 'x-forwarded-for': '1.1.1.1' }).status).toBe(200)
+    expect(get(app, '/items', { 'x-api-key': 'a', 'x-forwarded-for': '2.2.2.2' }).status).toBe(429)
+    expect(get(app, '/items', { 'x-forwarded-for': ' 3.3.3.3 , 4.4.4.4' }).status).toBe(200)
+    expect(get(app, '/items', { 'x-forwarded-for': '3.3.3.3' }).status).toBe(429)
+    expect(get(app).status).toBe(200)
+    expect(get(app).status).toBe(429)
+  })
+
+  it('never limits or counts /health', () => {
+    const { app } = setup(1, 60_000)
+    for (let i = 0; i < 3; i++) expect(get(app, '/health').status).toBe(200)
+    expect(get(app).status).toBe(200)
+    expect(get(app, '/health').status).toBe(200)
+  })
+
+  it('counts requests that end in a 404', () => {
+    const { app } = setup(1, 60_000)
+    expect(get(app, '/nope').status).toBe(404)
+    expect(get(app).status).toBe(429)
+  })
+
+  it('rejects settings that cannot work', () => {
+    expect(() => createApp({ rateLimit: { limit: 0, windowMs: 1000 } })).toThrow(RangeError)
+    expect(() => createApp({ rateLimit: { limit: 5, windowMs: 0 } })).toThrow(RangeError)
+  })
+})
