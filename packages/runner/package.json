{
  "name": "@coro-ai/runner",
  "version": "0.1.0",
  "description": "Coro Runner — local agent runtime, cloud control plane, and CLI (`coro` command).",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/cli/index.js",
  "bin": {
    "coro": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coro-ai-framework/coro-developer-framework.git",
    "directory": "packages/runner"
  },
  "bugs": "https://github.com/Coro-ai-framework/coro-developer-framework/issues",
  "homepage": "https://coro.build",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "coro",
    "ai",
    "agents",
    "workflow",
    "cli"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-plugin-assets.js",
    "start": "node dist/cli/index.js start",
    "start:cloud": "node dist/src/cloud/index.js",
    "dev": "tsx cli/index.ts start",
    "dev:cloud": "DOTENV_CONFIG_PATH=.env.cloud nodemon --exec ts-node src/cloud/index.ts",
    "dev:cli": "ts-node cli/index.ts",
    "db:generate": "DOTENV_CONFIG_PATH=.env.cloud drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.cloud drizzle-kit migrate",
    "db:push": "DOTENV_CONFIG_PATH=.env.cloud drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:mcp": "vitest run tests/mcp",
    "test:runner": "vitest run tests/runner",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@coro-ai/cloud-protocol": "workspace:*",
    "@coro-ai/intelligence-base": "workspace:*",
    "@coro-ai/llm-anthropic": "workspace:*",
    "@coro-ai/llm-openai": "workspace:*",
    "@coro-ai/plugin-sdk": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "js-yaml": "^4.2.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "simple-git": "^3.27.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
