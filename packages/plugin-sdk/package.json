{
  "name": "@coro-ai/plugin-sdk",
  "version": "0.1.0",
  "description": "Public SDK for authoring Coro plugins (SCM, tracker, …). Re-exports the runner's plugin contracts plus a small set of authoring helpers (HMAC verification, base classes, MCP-server descriptors).",
  "license": "BUSL-1.1",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails.d.ts",
      "default": "./dist/guardrails.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coro-ai-framework/coro-developer-framework.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": "https://github.com/Coro-ai-framework/coro-developer-framework/issues",
  "homepage": "https://coro.build",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "pino": "^9.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162"
  },
  "devDependencies": {
    "@coro-ai/cloud-protocol": "workspace:*",
    "@types/node": "^22.13.14",
    "pino": "^10.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
