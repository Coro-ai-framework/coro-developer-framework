{
  "name": "@coro-ai/plugin-gitlab",
  "version": "0.1.0",
  "description": "GitLab SCM plugin for Coro. MCP-mode plugin that delegates day-to-day SCM operations to the upstream `@modelcontextprotocol/server-gitlab` server while keeping the small set of native responsibilities Coro requires (clone URLs, webhook normalization, polling, self-improvement PR creation).",
  "license": "BUSL-1.1",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "intelligence",
    "coro-plugin.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coro-ai-framework/coro-developer-framework.git",
    "directory": "packages/plugin-gitlab"
  },
  "bugs": "https://github.com/Coro-ai-framework/coro-developer-framework/issues",
  "homepage": "https://coro.build",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coro-ai/plugin-sdk": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@coro-ai/cloud-protocol": "workspace:*",
    "@types/node": "^22.13.14",
    "pino": "^9.7.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
