{
  "name": "@coro-ai/cloud-protocol",
  "version": "0.1.0",
  "description": "Wire protocol shared between the Coro runner and the Coro cloud control plane. Pure TypeScript types, Zod schemas, and protocol constants — zero runtime side effects.",
  "license": "BUSL-1.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coro-ai-framework/coro-developer-framework.git",
    "directory": "packages/cloud-protocol"
  },
  "bugs": "https://github.com/Coro-ai-framework/coro-developer-framework/issues",
  "homepage": "https://coro.build",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
