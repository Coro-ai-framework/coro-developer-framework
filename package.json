{
  "name": "coro",
  "version": "0.1.0",
  "description": "Coro — multi-tenant, plug-and-play AI agent platform",
  "license": "BUSL-1.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:publishable": "pnpm --filter @coro-ai/cloud-protocol --filter @coro-ai/intelligence-base --filter @coro-ai/plugin-sdk --filter @coro-ai/dashboard --filter @coro-ai/llm-anthropic --filter @coro-ai/llm-openai --filter @coro-ai/plugin-gitlab --filter @coro-ai/runner run build",
    "prepare:runner-npm": "node scripts/prepare-runner-npm-publish.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:runner": "pnpm --filter @coro-ai/runner test",
    "verify:npm-pack": "node scripts/verify-npm-pack.mjs",
    "start": "pnpm --filter @coro-ai/runner start",
    "dev": "pnpm --filter @coro-ai/runner dev",
    "dev:runner": "pnpm --filter @coro-ai/runner dev",
    "dev:cloud": "pnpm --filter @coro-ai/runner dev:cloud",
    "dev:dashboard": "pnpm --filter @coro-ai/dashboard dev",
    "dev:landing": "pnpm --filter @coro-ai/landing dev",
    "build:landing": "pnpm --filter @coro-ai/landing build",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
